{
  "name": "@quantkupon/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "OpenAPI 3.1 specifications, Neon PostgreSQL DDL, and generated TypeScript types for QUANTKUPON",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./openapi.yaml": "./openapi.yaml",
    "./schema.sql": "./schema.sql"
  },
  "scripts": {
    "build": "pnpm run generate:types",
    "generate": "openapi-typescript openapi.yaml -o src/types.ts",
    "generate:types": "openapi-typescript openapi.yaml -o src/types.ts",
    "lint": "redocly lint openapi.yaml",
    "validate": "redocly lint openapi.yaml",
    "type-check": "tsc --noEmit",
    "test": "echo \"Contracts valid\""
  },
  "devDependencies": {
    "@redocly/cli": "^2.78.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.3"
  }
}
